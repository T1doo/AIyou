      "state": "current",
      "revision": 1
    },
    {
      "id": "r11",
      "text": "宋朔更正：我没有把那只蓝边陶碗送给唐序，只是借给他拍照，周末还要取回来。",
      "captured": "2026-09-15T11:25:00Z",
      "zone": "UTC",
      "names": [
        "宋朔",
        "唐序"
