          "alias": "阿澄",
          "name": "贺澄"
        }
      ],
      "event_date": null,
      "state": "current",
      "revision": 1
    },
    {
      "id": "r16",
      "text": "许南记：没有取消周六的修伞预约，只是把送伞时间从上午挪到下午；确认短信已经存好。",
      "captured": "2026-09-20T08:15:00Z",
      "zone": "Asia/Shanghai",
      "names": [
        "许南"
      ],
      "aliases": [
        {
          "alias": "南南",
          "name": "许南"
        }
      ],
      "event_date": "2026-09-26",
      "state": "current",
      "revision": 1
    },
    {
      "id": "r17",
      "text": "阿宁的自行车清洁便签：先擦掉车链外侧浮灰，再少量上油，最后擦去多余的油。",
      "captured": "2026-09-21T07:20:00Z",
