{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aiyou:local-rule-excerpts:1",
  "title": "Local rule excerpt candidate slice; other D05 extraction types remain open",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ruleVersion", "provenance", "sourceId", "sourceRevision", "sourceHash", "candidates"],
  "properties": {
    "schemaVersion": {"const": 1},
    "ruleVersion": {"const": 1},
    "provenance": {"const": "LOCAL_RULE_EXCERPT"},
    "sourceId": {"type": "string", "minLength": 1, "maxLength": 128},
    "sourceRevision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "sourceHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidates": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "start", "end", "quote"],
        "properties": {
          "kind": {"const": "EXCERPT"},
          "start": {"type": "integer", "minimum": 0, "maximum": 2147483647},
          "end": {"type": "integer", "minimum": 1, "maximum": 2147483647},
          "quote": {"type": "string", "minLength": 1, "maxLength": 320}
        }
      }
    }
  },
  "$comment": "The parser also rejects duplicate keys, malformed Unicode, whitespace-only quotes, oversized responses and invalid integer grammar. Repository checks current policy, epoch, revision, hash and exact half-open code-point references. Exact quotations do not establish semantic entailment. Review state and item IDs are assigned locally. Stable facts and executable tasks are outside v1."
}
